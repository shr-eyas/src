<?xml version="1.0"?>
<launch>
  <group ns="fr3_left">
    <arg name="robot" default="fr3_left"/>
    <arg name="arm_id" default="$(arg robot)"/>
    <arg name="robot_ip" default="192.168.1.15"/>
    <arg name="load_gripper" default="true"/>

    <include file="$(find franka_control)/launch/franka_control.launch">
      <arg name="robot_ip" value="$(arg robot_ip)"/>
      <arg name="arm_id" value="$(arg arm_id)"/>
      <arg name="load_gripper" value="$(arg load_gripper)"/>
    </include>

    <rosparam command="load"
              file="$(find multi_arm_controllers)/config/multi_arm_controllers.yaml"
              subst_value="true"/>

    <node pkg="controller_manager" type="spawner" name="right_spawner" output="screen"
          args="grav_comp"/>
  </group>

  <group ns="fr3_right">
    <arg name="robot" default="fr3_right"/>
    <arg name="arm_id" default="$(arg robot)"/>
    <arg name="robot_ip" default="192.168.1.11"/>
    <arg name="load_gripper" default="true"/>

    <include file="$(find franka_control)/launch/franka_control.launch">
      <arg name="robot_ip" value="$(arg robot_ip)"/>
      <arg name="arm_id" value="$(arg arm_id)"/>
      <arg name="load_gripper" value="$(arg load_gripper)"/>
    </include>

    <rosparam command="load"
              file="$(find multi_arm_controllers)/config/multi_arm_controllers.yaml"
              subst_value="true"/>

    <node pkg="controller_manager" type="spawner" name="left_spawner" output="screen"
          args="mirror_impedance"/>
  </group>

  <node pkg="tf2_ros" type="static_transform_publisher" name="right_to_left_base_tf"
      args="0 1.0 0 0 0 0 fr3_left_link0 fr3_right_link0"/>
</launch>
